import React, { useState, useEffect, useCallback } from 'react';
import { LineChart, Line, AreaChart, Area, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { TrendingUp, TrendingDown, Activity, Search, RefreshCw, Brain, Target, AlertCircle, Bell, BarChart3, Key, CheckCircle, Settings, X } from 'lucide-react';

const StockAnalysisPlatform = () => {
  const [selectedStock, setSelectedStock] = useState('AAPL');
  const [selectedTab, setSelectedTab] = useState('chart');
  const [stockData, setStockData] = useState(null);
  const [historicalData, setHistoricalData] = useState([]);
  const [marketNews, setMarketNews] = useState([]);
  const [aiAnalysis, setAiAnalysis] = useState('');
  const [loading, setLoading] = useState(false);
  const [dataLoading, setDataLoading] = useState(false);
  const [lastUpdate, setLastUpdate] = useState(new Date());
  const [searchQuery, setSearchQuery] = useState('');
  const [technicalIndicators, setTechnicalIndicators] = useState({});
  const [chartPeriod, setChartPeriod] = useState('1M');
  const [tradingSignals, setTradingSignals] = useState(null);
  
  // API Keys State
  const [showApiModal, setShowApiModal] = useState(false);
  const [apiKeys, setApiKeys] = useState({
    alphaVantage: '',
    finnhub: ''
  });
  const [tempApiKeys, setTempApiKeys] = useState({
    alphaVantage: '',
    finnhub: ''
  });
  const [apiStatus, setApiStatus] = useState({
    alphaVantage: false,
    finnhub: false
  });

  const majorStocks = [
    { symbol: 'SPY', name: 'S&P 500 ETF', sector: 'Index' },
    { symbol: 'AAPL', name: 'Apple Inc.', sector: 'Technology' },
    { symbol: 'MSFT', name: 'Microsoft', sector: 'Technology' },
    { symbol: 'GOOGL', name: 'Alphabet', sector: 'Technology' },
    { symbol: 'AMZN', name: 'Amazon', sector: 'E-commerce' },
    { symbol: 'TSLA', name: 'Tesla', sector: 'Automotive' },
    { symbol: 'META', name: 'Meta', sector: 'Technology' },
    { symbol: 'NVDA', name: 'NVIDIA', sector: 'Technology' },
    { symbol: 'JPM', name: 'JPMorgan', sector: 'Banking' },
    { symbol: 'V', name: 'Visa', sector: 'Financial' },
    { symbol: 'WMT', name: 'Walmart', sector: 'Retail' },
    { symbol: 'DIS', name: 'Disney', sector: 'Entertainment' },
  ];

  const [stocksList, setStocksList] = useState(majorStocks.map(s => ({...s, price: 0, change: 0})));

  const calculateSMA = (data, period) => {
    if (data.length < period) return data[data.length - 1] || 0;
    const slice = data.slice(-period);
    return slice.reduce((a, b) => a + b, 0) / period;
  };

  const calculateEMA = (data, period) => {
    if (data.length === 0) return 0;
    const k = 2 / (period + 1);
    let ema = data[0];
    for (let i = 1; i < data.length; i++) {
      ema = data[i] * k + ema * (1 - k);
    }
    return ema;
  };

  const calculateRSI = (prices, period = 14) => {
    if (prices.length < period + 1) return 50;
    let gains = 0;
    let losses = 0;
    for (let i = prices.length - period; i < prices.length; i++) {
      const change = prices[i] - prices[i - 1];
      if (change > 0) gains += change;
      else losses -= change;
    }
    const avgGain = gains / period;
    const avgLoss = losses / period;
    if (avgLoss === 0) return 100;
    const rs = avgGain / avgLoss;
    return 100 - (100 / (1 + rs));
  };

  // Fetch real data from Alpha Vantage
  const fetchAlphaVantageData = async (symbol) => {
    if (!apiKeys.alphaVantage) {
      throw new Error('Alpha Vantage API key not configured');
    }

    try {
      const quoteUrl = `https://www.alphavantage.co/query?function=GLOBAL_QUOTE&symbol=${symbol}&apikey=${apiKeys.alphaVantage}`;
      const quoteResponse = await fetch(quoteUrl);
      const quoteData = await quoteResponse.json();

      if (quoteData['Global Quote'] && Object.keys(quoteData['Global Quote']).length > 0) {
        const quote = quoteData['Global Quote'];
        return {
          symbol,
          price: parseFloat(quote['05. price']),
          change: parseFloat(quote['09. change']),
          changePercent: parseFloat(quote['10. change percent']?.replace('%', '')),
          volume: parseInt(quote['06. volume']),
          open: parseFloat(quote['02. open']),
          high: parseFloat(quote['03. high']),
          low: parseFloat(quote['04. low']),
        };
      }

      const historyUrl = `https://www.alphavantage.co/query?function=TIME_SERIES_DAILY&symbol=${symbol}&apikey=${apiKeys.alphaVantage}`;
      const historyResponse = await fetch(historyUrl);
      const historyData = await historyResponse.json();

      if (historyData['Time Series (Daily)']) {
        const timeSeries = historyData['Time Series (Daily)'];
        const formattedData = Object.entries(timeSeries)
          .slice(0, 30)
          .reverse()
          .map(([date, values]) => ({
            date: date.substring(5),
            price: parseFloat(values['4. close']),
            volume: parseInt(values['5. volume']),
            high: parseFloat(values['2. high']),
            low: parseFloat(values['3. low']),
          }));
        
        return { quote: quoteData, history: formattedData };
      }
    } catch (error) {
      console.error('Alpha Vantage Error:', error);
      throw error;
    }
  };

  // Fetch news from Finnhub
  const fetchFinnhubNews = async (symbol) => {
    if (!apiKeys.finnhub) return [];

    try {
      const today = new Date().toISOString().split('T')[0];
      const weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
      
      const newsUrl = `https://finnhub.io/api/v1/company-news?symbol=${symbol}&from=${weekAgo}&to=${today}&token=${apiKeys.finnhub}`;
      const response = await fetch(newsUrl);
      const newsData = await response.json();

      if (Array.isArray(newsData)) {
        return newsData.slice(0, 5).map(news => ({
          time: new Date(news.datetime * 1000).toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit' }),
          title: news.headline,
          summary: news.summary,
          source: news.source,
          url: news.url,
          impact: 'محايد'
        }));
      }
    } catch (error) {
      console.error('Finnhub Error:', error);
    }
    return [];
  };

  const generateDemoData = useCallback((symbol) => {
    const basePrice = Math.random() * 300 + 50;
    const change = (Math.random() - 0.5) * 10;
    const changePercent = (change / basePrice) * 100;
    
    setStockData({
      symbol,
      price: basePrice,
      change,
      changePercent,
      volume: Math.floor(Math.random() * 100000000),
      open: basePrice - Math.random() * 5,
      high: basePrice + Math.random() * 10,
      low: basePrice - Math.random() * 10,
    });

    const periods = 30;
    let price = basePrice;
    const data = [];
    
    for (let i = 0; i < periods; i++) {
      price += (Math.random() - 0.48) * 5;
      data.push({
        date: `${i+1}/10`,
        price,
        volume: Math.floor(Math.random() * 10000000),
        high: price + Math.random() * 3,
        low: price - Math.random() * 3,
      });
    }
    
    setHistoricalData(data);
    
    const prices = data.map(d => d.price);
    const rsi = calculateRSI(prices, 14);
    const sma20 = calculateSMA(prices, 20);
    const sma50 = calculateSMA(prices, Math.min(50, prices.length));
    
    setTechnicalIndicators({
      RSI: { 
        value: rsi.toFixed(2), 
        signal: rsi > 70 ? 'تشبع شرائي' : rsi < 30 ? 'تشبع بيعي' : 'محايد',
        color: rsi > 70 ? 'text-red-500' : rsi < 30 ? 'text-green-500' : 'text-yellow-500'
      },
      SMA20: { 
        value: sma20.toFixed(2), 
        signal: price > sma20 ? 'فوق المتوسط' : 'تحت المتوسط',
        color: price > sma20 ? 'text-green-500' : 'text-red-500'
      },
      SMA50: { 
        value: sma50.toFixed(2), 
        signal: price > sma50 ? 'اتجاه صاعد' : 'اتجاه هابط',
        color: price > sma50 ? 'text-green-500' : 'text-red-500'
      }
    });

    const support = Math.min(...data.slice(-20).map(d => d.low));
    const resistance = Math.max(...data.slice(-20).map(d => d.high));
    
    setTradingSignals({
      recommendation: rsi < 30 ? 'شراء' : rsi > 70 ? 'بيع' : 'انتظار',
      entry: support.toFixed(2),
      stopLoss: (support * 0.95).toFixed(2),
      takeProfit: resistance.toFixed(2),
      support: support.toFixed(2),
      resistance: resistance.toFixed(2),
    });

    setMarketNews([
      { time: '10:30', title: `${symbol} تعلن عن نتائج مالية قوية`, impact: 'إيجابي' },
      { time: '09:15', title: 'المحللون يرفعون التوصيات', impact: 'إيجابي' },
    ]);

    setStocksList(prev => prev.map(s => 
      s.symbol === symbol ? {...s, price: basePrice, change: changePercent} : s
    ));
  }, []);

  const loadData = async (symbol) => {
    setDataLoading(true);
    
    try {
      // Try real API first
      if (apiKeys.alphaVantage || apiKeys.finnhub) {
        if (apiKeys.alphaVantage) {
          const data = await fetchAlphaVantageData(symbol);
          if (data && data.quote) {
            setStockData(data.quote);
          }
          if (data && data.history) {
            setHistoricalData(data.history);
          }
        }
        
        if (apiKeys.finnhub) {
          const news = await fetchFinnhubNews(symbol);
          if (news.length > 0) {
            setMarketNews(news);
          }
        }
      } else {
        // Use demo data
        generateDemoData(symbol);
      }
    } catch (error) {
      console.error('Error loading data:', error);
      generateDemoData(symbol);
    } finally {
      setDataLoading(false);
      setLastUpdate(new Date());
    }
  };

  const saveApiKeys = () => {
    setApiKeys(tempApiKeys);
    setApiStatus({
      alphaVantage: !!tempApiKeys.alphaVantage,
      finnhub: !!tempApiKeys.finnhub
    });
    setShowApiModal(false);
    loadData(selectedStock);
  };

  const performAIAnalysis = () => {
    setLoading(true);
    setTimeout(() => {
      if (!stockData || !tradingSignals) {
        setAiAnalysis('يرجى تحميل بيانات السهم أولاً');
        setLoading(false);
        return;
      }

      const analysis = `التحليل الشامل بالذكاء الاصطناعي

${selectedStock} - ${majorStocks.find(s => s.symbol === selectedStock)?.name}

البيانات السعرية:
• السعر الحالي: $${stockData.price.toFixed(2)}
• التغير: ${stockData.changePercent >= 0 ? '+' : ''}${stockData.changePercent.toFixed(2)}%
• أعلى: $${stockData.high.toFixed(2)}
• أدنى: $${stockData.low.toFixed(2)}

المؤشرات الفنية:
• RSI: ${technicalIndicators.RSI?.value} - ${technicalIndicators.RSI?.signal}
• SMA 20: $${technicalIndicators.SMA20?.value} - ${technicalIndicators.SMA20?.signal}
• SMA 50: $${technicalIndicators.SMA50?.value} - ${technicalIndicators.SMA50?.signal}

إشارات التداول:
التوصية: ${tradingSignals.recommendation}

نقاط الدخول والخروج:
• نقطة الدخول: $${tradingSignals.entry}
• وقف الخسارة: $${tradingSignals.stopLoss}
• جني الأرباح: $${tradingSignals.takeProfit}

المستويات الحرجة:
• دعم: $${tradingSignals.support}
• مقاومة: $${tradingSignals.resistance}`;
      
      setAiAnalysis(analysis);
      setLoading(false);
    }, 1500);
  };

  useEffect(() => {
    loadData(selectedStock);
    const interval = setInterval(() => loadData(selectedStock), 60000);
    return () => clearInterval(interval);
  }, [selectedStock]);

  const filteredStocks = stocksList.filter(stock =>
    stock.symbol.toLowerCase().includes(searchQuery.toLowerCase()) ||
    stock.name.toLowerCase().includes(searchQuery.toLowerCase())
  );

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 text-white">
      <header className="bg-slate-900/80 backdrop-blur-lg border-b border-blue-500/30 sticky top-0 z-50">
        <div className="container mx-auto px-6 py-4">
          <div className="flex items-center justify-between flex-wrap gap-4">
            <div className="flex items-center gap-3">
              <div className="bg-gradient-to-r from-blue-500 to-cyan-500 p-2 rounded-lg">
                <Brain className="w-8 h-8" />
              </div>
              <div>
                <h1 className="text-2xl font-bold bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
                  منصة التحليل المالي الذكية
                </h1>
                <p className="text-xs text-slate-400">AI Stock Analysis Platform</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <button
                onClick={() => setShowApiModal(true)}
                className="flex items-center gap-2 bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg transition-all"
              >
                <Settings className="w-4 h-4" />
                <span className="text-sm">إعدادات API</span>
                {(apiStatus.alphaVantage || apiStatus.finnhub) && (
                  <CheckCircle className="w-4 h-4 text-green-400" />
                )}
              </button>
              <div className="flex items-center gap-2 bg-green-500/20 px-4 py-2 rounded-lg border border-green-500/30">
                <Activity className="w-4 h-4 text-green-400 animate-pulse" />
                <span className="text-sm text-green-400">
                  {(apiStatus.alphaVantage || apiStatus.finnhub) ? 'بيانات حية' : 'وضع تجريبي'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </header>

      {/* API Configuration Modal */}
      {showApiModal && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-slate-900 rounded-2xl border border-slate-700 p-6 max-w-2xl w-full">
            <div className="flex justify-between items-start mb-6">
              <div>
                <h2 className="text-2xl font-bold mb-2">إعدادات API Keys</h2>
                <p className="text-slate-400 text-sm">أدخل مفاتيح API للحصول على بيانات حقيقية مباشرة</p>
              </div>
              <button onClick={() => setShowApiModal(false)} className="text-slate-400 hover:text-white">
                <X className="w-6 h-6" />
              </button>
            </div>

            <div className="space-y-6">
              {/* Alpha Vantage */}
              <div className="bg-slate-800/50 rounded-lg p-4 border border-slate-700">
                <div className="flex items-center gap-3 mb-3">
                  <Key className="w-5 h-5 text-blue-400" />
                  <h3 className="font-bold text-lg">Alpha Vantage API</h3>
                  {apiStatus.alphaVantage && <CheckCircle className="w-5 h-5 text-green-400" />}
                </div>
                <p className="text-xs text-slate-400 mb-3">
                  للأسعار والبيانات التاريخية • 500 استدعاء يومياً مجاناً
                </p>
                <input
                  type="text"
                  placeholder="أدخل Alpha Vantage API Key"
                  value={tempApiKeys.alphaVantage}
                  onChange={(e) => setTempApiKeys({...tempApiKeys, alphaVantage: e.target.value})}
                  className="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500"
                />
                <a 
                  href="https://www.alphavantage.co/support/#api-key" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="text-xs text-blue-400 hover:text-blue-300 mt-2 inline-block"
                >
                  احصل على مفتاح مجاني من alphavantage.co ←
                </a>
              </div>

              {/* Finnhub */}
              <div className="bg-slate-800/50 rounded-lg p-4 border border-slate-700">
                <div className="flex items-center gap-3 mb-3">
                  <Key className="w-5 h-5 text-cyan-400" />
                  <h3 className="font-bold text-lg">Finnhub API</h3>
                  {apiStatus.finnhub && <CheckCircle className="w-5 h-5 text-green-400" />}
                </div>
                <p className="text-xs text-slate-400 mb-3">
                  للأخبار والبيانات الحية • 60 استدعاء في الدقيقة مجاناً
                </p>
                <input
                  type="text"
                  placeholder="أدخل Finnhub API Key"
                  value={tempApiKeys.finnhub}
                  onChange={(e) => setTempApiKeys({...tempApiKeys, finnhub: e.target.value})}
                  className="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-500"
                />
                <a 
                  href="https://finnhub.io/register" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="text-xs text-cyan-400 hover:text-cyan-300 mt-2 inline-block"
                >
                  احصل على مفتاح مجاني من finnhub.io ←
                </a>
              </div>

              {/* Instructions */}
              <div className="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4">
                <h4 className="font-bold text-blue-300 mb-2 flex items-center gap-2">
                  <AlertCircle className="w-4 h-4" />
                  كيفية الحصول على المفاتيح
                </h4>
                <ol className="text-xs text-slate-300 space-y-2">
                  <li>1. انقر على الروابط أعلاه للتسجيل مجاناً</li>
                  <li>2. املأ بياناتك الأساسية (الاسم والإيميل)</li>
                  <li>3. انسخ API Key المعروض لك</li>
                  <li>4. الصقه في الحقل المناسب هنا واضغط حفظ</li>
                </ol>
              </div>
            </div>

            <div className="flex gap-3 mt-6">
              <button
                onClick={saveApiKeys}
                className="flex-1 bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 px-6 py-3 rounded-lg font-bold"
              >
                حفظ وتفعيل
              </button>
              <button
                onClick={() => setShowApiModal(false)}
                className="px-6 py-3 bg-slate-700 hover:bg-slate-600 rounded-lg font-bold"
              >
                إلغاء
              </button>
            </div>
          </div>
        </div>
      )}

      <div className="container mx-auto px-6 py-8">
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
          <div className="lg:col-span-1">
            <div className="bg-slate-900/50 backdrop-blur-lg rounded-2xl border border-slate-700/50 p-6 sticky top-24">
              <div className="mb-4">
                <div className="relative">
                  <Search className="absolute right-3 top-3 w-5 h-5 text-slate-400" />
                  <input
                    type="text"
                    placeholder="ابحث عن سهم..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    className="w-full bg-slate-800 border border-slate-700 rounded-lg pr-10 pl-4 py-2 text-white focus:outline-none focus:border-blue-500"
                  />
                </div>
              </div>

              <h3 className="text-lg font-bold mb-4 flex items-center gap-2">
                <BarChart3 className="w-5 h-5 text-blue-400" />
                الأسهم المتاحة
              </h3>

              <div className="space-y-2 max-h-[500px] overflow-y-auto">
                {filteredStocks.map((stock) => (
                  <button
                    key={stock.symbol}
                    onClick={() => setSelectedStock(stock.symbol)}
                    className={`w-full text-right p-4 rounded-lg transition-all ${
                      selectedStock === stock.symbol
                        ? 'bg-blue-500/20 border-2 border-blue-500'
                        : 'bg-slate-800/50 border border-slate-700 hover:bg-slate-800'
                    }`}
                  >
                    <div className="flex justify-between items-start mb-2">
                      <div>
                        <div className="font-bold text-lg">{stock.symbol}</div>
                        <div className="text-xs text-slate-400">{stock.name}</div>
                      </div>
                      {stock.price > 0 && (
                        <div className="text-right">
                          <div className="font-bold">${stock.price.toFixed(2)}</div>
                          <div className={`text-sm ${stock.change >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                            {stock.change >= 0 ? '+' : ''}{stock.change.toFixed(2)}%
                          </div>
                        </div>
                      )}
                    </div>
                    <div className="text-xs text-slate-500 bg-slate-700/50 rounded px-2 py-1 inline-block">
                      {stock.sector}
                    </div>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div className="lg:col-span-3 space-y-6">
            {stockData && (
              <div className="bg-gradient-to-br from-slate-900/90 to-blue-900/30 backdrop-blur-lg rounded-2xl border border-blue-500/30 p-6">
                <div className="flex justify-between items-start mb-6 flex-wrap gap-4">
                  <div>
                    <h2 className="text-3xl font-bold mb-2">{majorStocks.find(s => s.symbol === selectedStock)?.name}</h2>
                    <p className="text-slate-400">{selectedStock}</p>
                  </div>
                  <div className="flex gap-2">
                    <button
                      onClick={() => loadData(selectedStock)}
                      disabled={dataLoading}
                      className="bg-slate
